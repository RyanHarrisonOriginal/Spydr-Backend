{
  "name": "spydah-ontology",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "build": "npm run build -w @spydr/config -w @spydr/ai && npm run build -w @spydr/db && npm run build -w @spydr/shared && npm run build -w @spydr/api -w @spydr/worker",
    "dev:api": "npm run dev -w @spydr/api",
    "dev:worker": "npm run dev -w @spydr/worker",
    "start:api": "npm run start -w @spydr/api",
    "start:worker": "npm run start -w @spydr/worker",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run db:generate -w @spydr/db",
    "db:push": "npm run db:push -w @spydr/db",
    "db:studio": "npm run db:studio -w @spydr/db"
  }
}
