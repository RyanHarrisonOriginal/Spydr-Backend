# Database: use a PostgreSQL connection string. Never commit real credentials.
# Example (Neon, Supabase, etc.):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clerk: both keys are required for @clerk/express. Get them from https://dashboard.clerk.com (API Keys).
# Use the same publishable key as the frontend (VITE_CLERK_PUBLISHABLE_KEY).
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Active Notes analyze (OpenAI). Keep this key server-side only — never commit real keys.
# If unset, the backend uses a stub provider so the frontend can still be exercised.
OPENAI_API_KEY=sk-...
# Optional model override (default: gpt-4o-mini)
# OPENAI_ACTIVE_NOTE_MODEL=gpt-4o-mini
