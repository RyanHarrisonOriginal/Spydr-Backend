{
  "name": "@spydr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:mcp-app": "vite build --config src/infra/mcp/app/vite.config.ts",
    "copy:mcp-app": "node -e \"const fs=require('fs');const p=require('path');const src=p.join('src','infra','mcp','app','ui-dist');const dest=p.join('dist','infra','mcp','app','ui-dist');fs.mkdirSync(p.dirname(dest),{recursive:true});fs.cpSync(src,dest,{recursive:true});console.log('copied mcp-app ui-dist ->',dest);\"",
    "build": "npm run build:mcp-app && node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc && npm run copy:mcp-app",
    "dev": "tsx watch src/index.ts",
    "mcp": "tsx src/mcp.ts",
    "start": "node dist/index.js",
    "start:mcp": "node dist/mcp.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/backend": "^3.2.0",
    "@clerk/express": "^2.0.4",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@spydr/active-notes": "*",
    "@spydr/ai": "*",
    "@spydr/config": "*",
    "@spydr/db": "*",
    "@spydr/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "openai": "^7.3.0",
    "pg-boss": "^12.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
