{
  "name": "@spydr/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "backfill:embeddings": "tsx src/scripts/backfill-project-embeddings.ts",
    "backfill:embeddings:enqueue": "tsx src/scripts/backfill-project-embeddings.ts --enqueue"
  },
  "dependencies": {
    "@spydr/active-notes": "*",
    "@spydr/ai": "*",
    "@spydr/config": "*",
    "@spydr/db": "*",
    "@spydr/shared": "*",
    "dotenv": "^17.4.2",
    "pg-boss": "^12.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
